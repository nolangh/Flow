{
  "name": "honeydo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:update-snapshots": "jest --updateSnapshot",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "detox:build:ios": "detox build --configuration ios.sim.debug",
    "detox:test:ios": "detox test --configuration ios.sim.debug",
    "detox:build:android": "detox build --configuration android.emu.debug",
    "detox:test:android": "detox test --configuration android.emu.debug",
    "e2e:ios": "npm run detox:build:ios && npm run detox:test:ios",
    "e2e:android": "npm run detox:build:android && npm run detox:test:android",
    "maestro:all": "maestro test .maestro/",
    "lint": "eslint .",
    "lint:biome": "npx biome check .",
    "lint:biome:fix": "npx biome check --write .",
    "typescript": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=high",
    "security:snyk": "npx snyk test --severity-threshold=high",
    "security:snyk:monitor": "npx snyk monitor",
    "security:all": "npm run security:audit && npm run security:snyk"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.0.14",
    "@sentry/react-native": "^8.7.0",
    "@supabase/supabase-js": "^2.50.0",
    "@trigger.dev/sdk": "^3.3.17",
    "ajv": "^8.18.0",
    "date-fns": "^4.1.0",
    "expo": "^54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "^55.0.18",
    "expo-web-browser": "~15.0.10",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@biomejs/biome": "^2.4.10",
    "@config-plugins/detox": "^11.0.0",
    "@storybook/addon-ondevice-actions": "^10.3.1",
    "@storybook/addon-ondevice-backgrounds": "^10.3.1",
    "@storybook/addon-ondevice-controls": "^10.3.1",
    "@storybook/addon-ondevice-notes": "^10.3.1",
    "@storybook/react-native": "^10.3.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/react": "~19.1.10",
    "@types/react-native": "~0.73.0",
    "detox": "^20.50.1",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0",
    "supabase": "^2.84.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|nativewind)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "constants/**/*.ts",
      "store/**/*.ts",
      "components/**/*.{ts,tsx}",
      "hooks/**/*.ts",
      "!**/*.d.ts",
      "!**/*.stories.{ts,tsx}"
    ]
  },
  "private": true
}
